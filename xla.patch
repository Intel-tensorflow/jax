+
+namespace se = stream_executor;
+
+namespace stream_executor::sycl {
+namespace {
+
+class CubScanKernelSyclTest
+    : public ::testing::Test,
+      public ::testing::WithParamInterface<std::tuple<
+          xla::PrimitiveType, size_t, size_t, size_t, CubScanKind, bool>> {
+ protected:
+  void SetUp() override {
+    ASSERT_OK_AND_ASSIGN(platform_,
+                         se::PlatformManager::PlatformWithName("SYCL"));
+    ASSERT_OK_AND_ASSIGN(executor_, platform_->ExecutorForDevice(0));
+    ASSERT_OK_AND_ASSIGN(stream_, executor_->CreateStream(std::nullopt));
+  }
+
+  ::sycl::queue* queue() {
+    return static_cast<::sycl::queue*>(
+        stream_->platform_specific_handle().stream);
+  }
+
+ public:
+  // ComputeT is the type used for host-side reference accumulation. For 16-bit
+  // floats it is `float`, so the reference matches the device's fp32
+  // accumulation semantics.
+  template <typename T, typename ComputeT = T>
+  absl::Status RunCubScanTest(xla::PrimitiveType type, size_t vector_length,
+                              size_t row_length, size_t col_length,
+                              CubScanKind kind, bool is_reverse) {
+    SCOPED_TRACE(absl::StrFormat(
+        "type=%s vector_length=%d row_length=%d col_length=%d",
+        xla::primitive_util::LowercasePrimitiveTypeName(type), vector_length,
+        row_length, col_length));
+
+    constexpr bool kIsHalfPrecision =
+        std::is_same_v<T, ::sycl::half> ||
+        std::is_same_v<T, ::sycl::ext::oneapi::bfloat16>;
+    size_t num_elements = vector_length * row_length * col_length;
+    std::vector<T> host_data(num_elements);
+    std::vector<ComputeT> expected(num_elements);
+    size_t idx = 0;
+    for (size_t i = 0; i < col_length; ++i) {
+      ComputeT sum = ComputeT{};
+      for (size_t j = 0; j < row_length; ++j) {
+        ComputeT value = static_cast<ComputeT>((i + j) % 5);
+        // Round-trip through the storage type to mirror device precision.
+        T stored = static_cast<T>(value);
+        sum += static_cast<ComputeT>(stored);
+        sum = static_cast<ComputeT>(static_cast<T>(sum));
+        host_data[idx] = stored;
+        expected[idx] = sum;
+        ++idx;
+      }
+    }
+
+    // The oneDPL backend allocates its own temporaries, so `CubScan` takes no
+    // caller-provided scratch buffer.
+    se::DeviceAddress<T> device_in = executor_->AllocateArray<T>(num_elements);
+    auto in_cleanup =
+        absl::MakeCleanup([&]() { executor_->Deallocate(&device_in); });
+    se::DeviceAddress<T> device_out = executor_->AllocateArray<T>(num_elements);
+    auto out_cleanup =
+        absl::MakeCleanup([&]() { executor_->Deallocate(&device_out); });
+
+    size_t size_bytes = num_elements * sizeof(T);
+    ABSL_RETURN_IF_ERROR(
+        stream_->Memcpy(&device_in, host_data.data(), size_bytes));
+
+    ABSL_RETURN_IF_ERROR(CubScan<T>(device_in.opaque(), device_out.opaque(),
+                                    vector_length, row_length, col_length, kind,
+                                    is_reverse, queue()));
+
+    ABSL_RETURN_IF_ERROR(stream_->BlockHostUntilDone());
+    ABSL_RETURN_IF_ERROR(
+        stream_->Memcpy(host_data.data(), device_out, size_bytes));
+
+    for (size_t k = 0; k < num_elements; ++k) {
+      if constexpr (kIsHalfPrecision) {
+        EXPECT_FLOAT_EQ(static_cast<float>(host_data[k]),
+                        static_cast<float>(expected[k]));
+      } else if constexpr (std::is_same_v<T, float>) {
+        EXPECT_FLOAT_EQ(host_data[k], expected[k]);
+      } else if constexpr (std::is_same_v<T, double>) {
+        EXPECT_DOUBLE_EQ(host_data[k], expected[k]);
+      } else {
+        EXPECT_EQ(host_data[k], expected[k]);
+      }
+    }
+    return absl::OkStatus();
+  }
+
+ private:
+  se::Platform* platform_;
+  se::StreamExecutor* executor_;
+  std::unique_ptr<se::Stream> stream_;
+};
+
+TEST_P(CubScanKernelSyclTest, TestPrefixSum) {
+  const auto& params = GetParam();
+  auto type = std::get<xla::PrimitiveType>(params);
+  const size_t row_length = std::get<2>(params);
+  if ((type == xla::PrimitiveType::BF16 || type == xla::PrimitiveType::F16) &&
+      row_length > 128) {
+    GTEST_SKIP() << "16-bit float for row length > 128 has precision issues.";
+  }
+  switch (type) {
+    case xla::PrimitiveType::BF16:
+      EXPECT_OK(std::apply(
+          &CubScanKernelSyclTest::RunCubScanTest<
+              ::sycl::ext::oneapi::bfloat16, float>,
+          std::tuple_cat(std::make_tuple(this), params)));
+      return;
+    case xla::PrimitiveType::F16:
+      EXPECT_OK(std::apply(
+          &CubScanKernelSyclTest::RunCubScanTest<::sycl::half, float>,
+          std::tuple_cat(std::make_tuple(this), params)));
+      return;
+    default:
+      break;
+  }
+  auto impl = [&](auto value) {
+    EXPECT_OK(std::apply(
+        &CubScanKernelSyclTest::RunCubScanTest<decltype(value)>,
+        std::tuple_cat(std::make_tuple(this), params)));
+  };
+  switch (type) {
+    case xla::PrimitiveType::F32:
+      return impl(float{});
+    case xla::PrimitiveType::F64:
+      return impl(double{});
+    case xla::PrimitiveType::S8:
+      return impl(int8_t{});
+    case xla::PrimitiveType::S16:
+      return impl(int16_t{});
+    case xla::PrimitiveType::S32:
+      return impl(int32_t{});
+    case xla::PrimitiveType::S64:
+      return impl(int64_t{});
+    case xla::PrimitiveType::U8:
+      return impl(uint8_t{});
+    case xla::PrimitiveType::U16:
+      return impl(uint16_t{});
+    case xla::PrimitiveType::U32:
+      return impl(uint32_t{});
+    case xla::PrimitiveType::U64:
+      return impl(uint64_t{});
+    default:
+      FAIL() << "Unsupported element type for CUB scan";
+  }
+}
+
+std::string CubScanKindToString(CubScanKind kind) {
+  switch (kind) {
+    case CubScanKind::kSum:
+      return "Sum";
+    case CubScanKind::kInvalid:
+      return "Invalid";
+  }
+}
+
+std::string ParametersToString(
+    const ::testing::TestParamInfo<::testing::tuple<
+        xla::PrimitiveType, size_t, size_t, size_t, CubScanKind, bool>>& data) {
+  const auto& [type, vector_length, row_length, col_length, kind, is_reverse] =
+      data.param;
+  return absl::StrFormat("%s_%s_%dx%dx%d_%s", CubScanKindToString(kind),
+                         is_reverse ? "reverse" : "forward", col_length,
+                         row_length, vector_length,
+                         xla::primitive_util::LowercasePrimitiveTypeName(type));
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    CubScanKernelSyclTestInstance, CubScanKernelSyclTest,
+    ::testing::Combine(::testing::ValuesIn({xla::BF16, xla::F16, xla::F32,
+                                            xla::F64, xla::S8, xla::S16,
+                                            xla::S32, xla::S64, xla::U8,
+                                            xla::U16, xla::U32, xla::U64}),
+                       ::testing::Values(size_t{1}),
+                       ::testing::ValuesIn<size_t>({1, 2, 3, 128, 511, 513}),
+                       ::testing::ValuesIn<size_t>({1, 2, 3, 128, 511, 512}),
+                       ::testing::Values(CubScanKind::kSum),
+                       ::testing::Values(false)),
+    ParametersToString);
+
+}  // namespace
+}  // namespace stream_executor::sycl
