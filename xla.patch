+absl::Status CubSortPairs(void* d_temp_storage, size_t& temp_bytes,
+                          const void* d_keys_in, void* d_keys_out,
+                          const void* d_values_in, void* d_values_out,
+                          size_t num_items, bool descending, size_t batch_size,
+                          ::sycl::queue* stream);
