+template <dft::precision P, dft::domain D>
+using Descriptor = dft::descriptor<P, D>;
+
+// The real scalar type oneMKL uses for a given descriptor precision.
+template <dft::precision P>
+using RealScalar =
+    std::conditional_t<P == dft::precision::DOUBLE, double, float>;
+
+// The oneMKL routine that computes a transform.
+//
+// oneMKL only instantiates compute_forward() for the real -> complex direction
+// of a real transform and compute_backward() for its complex -> real
+// direction, so for those the routine follows from the element types and has
+// to be picked at compile time. A complex-to-complex transform in contrast
+// uses the same element types and the same descriptor for both directions, so
+// there the routine is only known once the plan is created.
+enum class Direction { kForward, kBackward, kFromPlan };
+
+// Maps the element types of a DoFft() call onto the oneMKL descriptor that has
+// to back the plan, and onto the routine the transform is computed with.
+template <typename InputT, typename OutputT>
+struct OneMklFftTraits;
+
+#define STREAM_EXECUTOR_SYCL_FFT_TRAITS(__input, __output, __precision,       \
+                                        __domain, __direction)                \
+  template <>                                                                 \
+  struct OneMklFftTraits<__input, __output> {                                 \
+    static constexpr dft::precision kPrecision = dft::precision::__precision; \
+    static constexpr dft::domain kDomain = dft::domain::__domain;             \
+    static constexpr Direction kDirection = Direction::__direction;           \
+  }
+
+// input type, output type, precision, domain, direction:
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(std::complex<float>, std::complex<float>,
+                                SINGLE, COMPLEX, kFromPlan);
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(std::complex<double>, std::complex<double>,
+                                DOUBLE, COMPLEX, kFromPlan);
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(float, std::complex<float>,  //
+                                SINGLE, REAL, kForward);
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(double, std::complex<double>,  //
+                                DOUBLE, REAL, kForward);
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(std::complex<float>, float,  //
+                                SINGLE, REAL, kBackward);
+STREAM_EXECUTOR_SYCL_FFT_TRAITS(std::complex<double>, double,  //
+                                DOUBLE, REAL, kBackward);
+
+#undef STREAM_EXECUTOR_SYCL_FFT_TRAITS
+
+// Returns true for the transforms oneMKL computes with compute_forward().
+bool IsForward(fft::Type type) {
+  switch (type) {
+    case fft::Type::kC2CForward:
+    case fft::Type::kZ2ZForward:
+    case fft::Type::kR2C:
+    case fft::Type::kD2Z:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Returns true if the transform's backward domain holds the conjugate-even
+// (i.e. only n/2+1 elements along the last axis) representation of the signal.
+bool IsRealTransform(fft::Type type) {
+  switch (type) {
+    case fft::Type::kR2C:
+    case fft::Type::kD2Z:
+    case fft::Type::kC2R:
+    case fft::Type::kZ2D:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Returns the layout of one of the transform's domains, expressed as the oneMKL
+// stride vector {offset, stride_of_dim_0, ..., stride_of_dim_rank-1}.
+//
+// `embed` is the plan's `input_embed` or `output_embed`: the storage dimensions
+// of the data, which may exceed the transform itself when the signal is padded.
+// `elem_stride` is the distance between two successive elements along the last
+// axis. If `embed` is null the data is assumed to be densely packed, in which
+// case the dimensions are `fft_length`, except that the last axis of a
+// conjugate-even domain only holds n/2+1 elements.
+std::vector<std::int64_t> DomainStrides(int rank, const std::uint64_t* embed,
+                                       std::uint64_t elem_stride,
+                                       const std::uint64_t* fft_length,
+                                       bool conjugate_even) {
+  std::vector<std::int64_t> dims(rank);
+  for (int i = 0; i < rank; ++i) {
+    dims[i] = embed != nullptr ? embed[i] : fft_length[i];
+  }
+  if (embed == nullptr && conjugate_even) {
+    dims[rank - 1] = dims[rank - 1] / 2 + 1;
+  }
+
+  // Row-major strides: the last axis is the fastest varying one. The dimensions
+  // arrive in major-to-minor order from the FFT thunk.
+  std::vector<std::int64_t> strides(rank + 1);
+  strides[0] = 0;  // Offset of the first element of a transform.
+  std::int64_t stride = elem_stride;
+  for (int i = rank; i >= 1; --i) {
+    strides[i] = stride;
+    stride *= dims[i - 1];
+  }
+  return strides;
+}
+
+// Returns the SYCL queue backing `stream`.
+::sycl::queue* SyclQueue(Stream* stream) {
+  return absl::bit_cast<::sycl::queue*>(
+      stream->platform_specific_handle().stream);
+}
+
+// How the input of a complex -> real transform is laid out in memory, as needed
+// by ProjectConjugateEvenHyperplanes() below.
+struct ConjugateEvenLayout {
+  int rank = 0;
+  // Logical length and element stride of every transformed axis.
+  std::int64_t lengths[3] = {1, 1, 1};
+  std::int64_t strides[3] = {0, 0, 0};
+  // Elements between two consecutive transforms of the batch.
+  std::int64_t distance = 0;
+  int batch_count = 1;
+  // Elements stored along the last transformed axis, n / 2 + 1 when the data is
+  // densely packed.
+  std::int64_t last_extent = 0;
+};
+
+// oneMKL expects a conjugate-even input, X[-j] == conj(X[j]). XLA does not
+// guarantee one: like NumPy, it ignores the imaginary parts of the DC and the
+// Nyquist element of the last axis, and jnp.fft.hfft() relies on that. oneMKL
+// uses them, so [0, 0, i] transforms to -1 everywhere instead of all zeros.
+//
+// Averaging X[j] with conj(X[-j]) on those two hyperplanes drops what XLA
+// ignores and leaves a valid input alone. For rank 1 it just zeroes the two
+// imaginary parts; higher ranks need the average because oneMKL transforms the
+// leading axes first, and IFFT(conj(X[-j])) == conj(IFFT(X)).
+//
+// Modifies `data` in place, so pass a copy (see ConjugateEvenInput()).
+template <typename ComplexT>
+absl::Status ProjectConjugateEvenHyperplanes(
+    ::sycl::queue* queue, ComplexT* data, const ConjugateEvenLayout& layout) {
+  using RealT = typename ComplexT::value_type;
+
+  const int rank = layout.rank;
+  if (rank < 1 || rank > 3) {
+    return absl::InternalError(absl::StrCat(
+        "The plan of a complex -> real oneMKL DFT recorded no conjugate-even "
+        "domain of rank 1, 2 or 3, but one of rank ",
+        rank, "."));
+  }
+  // The rank is at most 3, so there are at most two leading axes.
+  const std::int64_t n0 = rank > 1 ? layout.lengths[0] : 1;
+  const std::int64_t n1 = rank > 2 ? layout.lengths[1] : 1;
+  const std::int64_t stride0 = rank > 1 ? layout.strides[0] : 0;
+  const std::int64_t stride1 = rank > 2 ? layout.strides[1] : 0;
+  const std::int64_t last_length = layout.lengths[rank - 1];
+  const std::int64_t last_stride = layout.strides[rank - 1];
+  const std::int64_t distance = layout.distance;
+  const std::int64_t hyperplane_size = n0 * n1;
+  const std::int64_t element_count = layout.batch_count * hyperplane_size;
+  if (element_count <= 0 || layout.last_extent < 1) return absl::OkStatus();
+
+  // Nyquist only has to be real for an even length, and is only stored when the
+  // data holds all n / 2 + 1 elements, as a well-formed XLA input does.
+  const std::int64_t hyperplanes[2] = {0, last_length / 2};
+  const int hyperplane_count =
+      last_length % 2 == 0 && last_length / 2 < layout.last_extent ? 2 : 1;
+
+  // std::complex<T> has the same layout as T[2]; indexing the components keeps
+  // complex arithmetic out of the kernel.
+  auto* elements = reinterpret_cast<RealT*>(data);
+
+  // No oneMKL call here; ExecMklFunc() is reused to turn a thrown
+  // ::sycl::exception into a status.
+  return ExecMklFunc([&] {
+    for (int i = 0; i < hyperplane_count; ++i) {
+      const std::int64_t hyperplane_offset = hyperplanes[i] * last_stride;
+      queue->parallel_for(
+          ::sycl::range<1>(element_count), [=](::sycl::id<1> id) {
+            const std::int64_t index = static_cast<std::int64_t>(id[0]);
+            const std::int64_t j1 = index % n1;
+            const std::int64_t j0 = (index / n1) % n0;
+            const std::int64_t batch = index / hyperplane_size;
+            const std::int64_t mirror0 = j0 == 0 ? 0 : n0 - j0;
+            const std::int64_t mirror1 = j1 == 0 ? 0 : n1 - j1;
+            // An element and its mirror read each other, so one work item of
+            // every pair writes both and the other one returns.
+            if (mirror0 * n1 + mirror1 < j0 * n1 + j1) return;
+            const std::int64_t base = batch * distance + hyperplane_offset;
+            const std::int64_t self = 2 * (base + j0 * stride0 + j1 * stride1);
+            const std::int64_t mirror =
+                2 * (base + mirror0 * stride0 + mirror1 * stride1);
+            const RealT real = (elements[self] + elements[mirror]) / 2;
+            const RealT imag = (elements[self + 1] - elements[mirror + 1]) / 2;
+            elements[self] = real;
+            elements[self + 1] = imag;
+            elements[mirror] = real;
+            elements[mirror + 1] = -imag;
+          });
+    }
+  });
+}
+
+// Returns a copy of `input` with the DC and Nyquist hyperplanes made
+// conjugate-even (see ProjectConjugateEvenHyperplanes()). Has to be a copy:
+// jax's fft_test.py::testLaxIrfftDoesNotMutateInputs checks that the caller's
+// buffer is untouched. Returns `input` if the copy fails, giving up on matching
+// the other backends.
+template <typename InputT>
+DeviceAddress<InputT> ConjugateEvenInput(Stream* stream,
+                                         const DeviceAddress<InputT>& input,
+                                         ScratchAllocator* scratch_allocator,
+                                         const ConjugateEvenLayout& layout) {
+  if (scratch_allocator == nullptr) {
+    LOG(ERROR) << "No scratch allocator to copy the input of a complex -> real "
+                  "oneMKL DFT with.";
+    return input;
+  }
+  absl::StatusOr<DeviceAddress<std::uint8_t>> scratch =
+      scratch_allocator->AllocateBytes(input.size());
+  if (!scratch.ok()) {
+    LOG(ERROR) << "Failed to allocate " << input.size()
+               << " bytes for a copy of the input of a complex -> real oneMKL "
+                  "DFT: "
+               << scratch.status().message();
+    return input;
+  }
+  DeviceAddress<InputT> input_copy(*scratch);
+  if (absl::Status status = stream->Memcpy(&input_copy, input, input.size());
+      !status.ok()) {
+    LOG(ERROR) << "Failed to copy the input of a complex -> real oneMKL DFT: "
+               << status.message();
+    return input;
+  }
+  if (absl::Status status = ProjectConjugateEvenHyperplanes(
+          SyclQueue(stream), GpuMemoryMutable(&input_copy), layout);
+      !status.ok()) {
+    LOG(ERROR) << "Failed to project the input of a complex -> real oneMKL DFT "
+                  "onto the conjugate-even subspace: "
+               << status.message();
+    return input;
+  }
+  return input_copy;
+}
+
+// An FFT plan holding a committed oneMKL DFT descriptor. The descriptor type
+// depends on the precision and the domain of the transform, so the plan keeps
+// it in a variant and hands it back to the (templated) execute path.
+//
+// Like the other fft::Plan implementations, a plan is not internally
+// synchronized: callers serialize access to it. FftThunk does so by holding
+// FftPlan::mu across both the creation and the execution of a plan.
+class SyclFftPlan : public fft::Plan {
+ public:
+  absl::Status Initialize(Stream* stream, int rank, std::uint64_t* fft_length,
+                          std::uint64_t* input_embed,
+                          std::uint64_t input_stride,
+                          std::uint64_t input_distance,
+                          std::uint64_t* output_embed,
+                          std::uint64_t output_stride,
+                          std::uint64_t output_distance, fft::Type type,
+                          bool in_place_fft, int batch_count);
+
+  // Returns the descriptor of the plan, or null if the plan was created for a
+  // different precision or domain.
+  template <dft::precision P, dft::domain D>
+  Descriptor<P, D>* GetDescriptor() {
+    auto* holder = std::get_if<std::unique_ptr<Descriptor<P, D>>>(&descriptor_);
+    return holder == nullptr ? nullptr : holder->get();
+  }
+
+  // Commits this plan's descriptor to `queue`, unless it is already committed
+  // there.
+  //
+  // oneMKL needs a descriptor committed after configuration and before any
+  // transform. commit() validates the configuration, factorizes the lengths to
+  // pick a computation method and allocates the internal work area, throwing if
+  // it cannot; ExecMklFunc() turns that into a Status.
+  //
+  // It also binds the descriptor to `queue`: compute_forward() and
+  // compute_backward() take no queue and enqueue on the last-committed one.
+  // Since FftPlanCache caches a plan per device ordinal rather than per stream,
+  // a plan reused on another stream must be re-committed to run there. Commit
+  // is the expensive planning step, so an already-committed queue is skipped --
+  // safe because each plan owns exactly one descriptor.
+  absl::Status CommitOn(::sycl::queue* queue);
+
+  bool is_forward() const { return is_forward_; }
+
+  // Layout of the input of a complex -> real transform. rank == 0 for any other
+  // transform.
+  const ConjugateEvenLayout& conjugate_even_layout() const {
+    return conjugate_even_layout_;
+  }
+
+  // Allocator for the input copy of a complex -> real transform, or null. Only
+  // valid during the execution fft_thunk.cc set it for.
+  ScratchAllocator* scratch_allocator() const { return scratch_allocator_; }
+  void set_scratch_allocator(ScratchAllocator* scratch_allocator) {
+    scratch_allocator_ = scratch_allocator;
+  }
+
+ private:
+  // Sets up the descriptor for the given precision and domain: applies the
+  // configuration below to a fresh descriptor, stores it in `descriptor_` along
+  // with the `commit_` that goes with it, and commits it to the queue of
+  // `stream`. `lengths` are the logical transform dimensions, the strides and
+  // distances describe the forward and the backward domain respectively.
+  template <dft::precision P, dft::domain D>
+  absl::Status ConfigureDescriptor(Stream* stream,
+                                   std::vector<std::int64_t> lengths,
+                                   const std::vector<std::int64_t>& fwd_strides,
+                                   const std::vector<std::int64_t>& bwd_strides,
+                                   std::int64_t fwd_distance,
+                                   std::int64_t bwd_distance, int batch_count);
+
+  std::variant<std::monostate,
+               std::unique_ptr<Descriptor<dft::precision::SINGLE,
+                                          dft::domain::COMPLEX>>,
+               std::unique_ptr<
+                   Descriptor<dft::precision::SINGLE, dft::domain::REAL>>,
+               std::unique_ptr<Descriptor<dft::precision::DOUBLE,
+                                          dft::domain::COMPLEX>>,
+               std::unique_ptr<
+                   Descriptor<dft::precision::DOUBLE, dft::domain::REAL>>>
+      descriptor_;
+
+  // Commits the type-erased descriptor above to a queue.
+  std::function<void(::sycl::queue&)> commit_;
+
+  // Queue the descriptor above is currently committed to. Only ever compared
+  // against the descriptor it belongs to; it says nothing about the descriptors
+  // of other plans that may run on the same queue.
+  ::sycl::queue* committed_queue_ = nullptr;
+
+  bool is_forward_ = false;
+
+  ConjugateEvenLayout conjugate_even_layout_;
+
+  ScratchAllocator* scratch_allocator_ = nullptr;
+};
+
+template <dft::precision P, dft::domain D>
+absl::Status SyclFftPlan::ConfigureDescriptor(
+    Stream* stream, std::vector<std::int64_t> lengths,
+    const std::vector<std::int64_t>& fwd_strides,
+    const std::vector<std::int64_t>& bwd_strides, std::int64_t fwd_distance,
+    std::int64_t bwd_distance, int batch_count) {
+  auto descriptor = std::make_unique<Descriptor<P, D>>(std::move(lengths));
+  // set_value() reports a rejected parameter by throwing, and ExecMklFunc()
+  // turns that into a Status. Setting everything inside one lambda therefore
+  // needs a single try/catch instead of one per parameter: the first rejected
+  // parameter skips the rest, and its message is returned below.
+  absl::Status status = ExecMklFunc(
+      [&] {
+        Descriptor<P, D>& desc = *descriptor;
+        desc.set_value(dft::config_param::NUMBER_OF_TRANSFORMS,
+                       static_cast<std::int64_t>(batch_count));
+        desc.set_value(dft::config_param::PLACEMENT,
+                       dft::config_value::NOT_INPLACE);
+        if constexpr (D == dft::domain::COMPLEX) {
+          desc.set_value(dft::config_param::COMPLEX_STORAGE,
+                         dft::config_value::COMPLEX_COMPLEX);
+        }
+        // The backward domain of a real transform holds the n/2+1 complex
+        // elements of the conjugate-even spectrum interleaved, which is the
+        // layout XLA expects. That is the only storage oneMKL
+        // supports, so CONJUGATE_EVEN_STORAGE is deprecated and not set here.
+        desc.set_value(dft::config_param::FWD_STRIDES, fwd_strides);
+        desc.set_value(dft::config_param::BWD_STRIDES, bwd_strides);
+        desc.set_value(dft::config_param::FWD_DISTANCE, fwd_distance);
+        desc.set_value(dft::config_param::BWD_DISTANCE, bwd_distance);
+        // XLA expects unnormalized transforms in both directions; the 1/n
+        // scaling of inverse transforms is applied by the caller (see
+        // fft_thunk.cc).
+        desc.set_value(dft::config_param::FORWARD_SCALE, RealScalar<P>{1});
+        desc.set_value(dft::config_param::BACKWARD_SCALE, RealScalar<P>{1});
+      });
+  if (!status.ok()) {
+    return absl::InternalError(absl::StrCat(
+        "Failed to configure the oneMKL DFT descriptor: ", status.message()));
+  }
+
+  Descriptor<P, D>* descriptor_ptr = descriptor.get();
+  commit_ = [descriptor_ptr](::sycl::queue& queue) {
+    descriptor_ptr->commit(queue);
+  };
+  descriptor_ = std::move(descriptor);
+  return CommitOn(SyclQueue(stream));
+}
+
+absl::Status SyclFftPlan::CommitOn(::sycl::queue* queue) {
+  // `committed_queue_` is per-plan state, not shared: it records the queue that
+  // *this* plan's one descriptor is committed on. A different plan on the same
+  // queue has its own, still null, so it commits its own descriptor rather than
+  // skipping here.
+  if (queue == committed_queue_) {
+    return absl::OkStatus();
+  }
+  absl::Status status = ExecMklFunc([&] { commit_(*queue); });
+  if (!status.ok()) {
+    return absl::InternalError(absl::StrCat(
+        "Failed to commit the oneMKL DFT descriptor: ", status.message()));
+  }
+  committed_queue_ = queue;
+  return absl::OkStatus();
+}
+
+absl::Status SyclFftPlan::Initialize(
+    Stream* stream, int rank, std::uint64_t* fft_length,
+    std::uint64_t* input_embed, std::uint64_t input_stride,
+    std::uint64_t input_distance, std::uint64_t* output_embed,
+    std::uint64_t output_stride, std::uint64_t output_distance, fft::Type type,
+    bool in_place_fft, int batch_count) {
+  if (rank < 1 || rank > 3) {
+    return absl::InvalidArgumentError(absl::StrCat(
+        "oneMKL DFT only supports rank 1, 2 or 3, given: ", rank));
+  }
+  if (in_place_fft) {
+    return absl::UnimplementedError(
+        "In-place FFT is not implemented for the SYCL platform.");
+  }
+  if (!std::holds_alternative<std::monostate>(descriptor_)) {
+    return absl::InternalError("oneMKL DFT plan should be uninitialized.");
+  }
+  is_forward_ = IsForward(type);
+  const bool conjugate_even = IsRealTransform(type);
+
+  std::vector<std::int64_t> lengths(rank);
+  for (int i = 0; i < rank; ++i) {
+    lengths[i] = static_cast<std::int64_t>(fft_length[i]);
+  }
+
+  // The forward domain holds the (real or complex) signal, the backward domain
+  // its spectrum. Which one of them is the input depends on the direction.
+  const bool input_is_forward_domain = is_forward_;
+  const std::uint64_t* fwd_embed =
+      input_is_forward_domain ? input_embed : output_embed;
+  const std::uint64_t* bwd_embed =
+      input_is_forward_domain ? output_embed : input_embed;
+  const std::uint64_t fwd_elem_stride =
+      input_is_forward_domain ? input_stride : output_stride;
+  const std::uint64_t bwd_elem_stride =
+      input_is_forward_domain ? output_stride : input_stride;
+  const std::int64_t fwd_distance = static_cast<std::int64_t>(
+      input_is_forward_domain ? input_distance : output_distance);
+  const std::int64_t bwd_distance = static_cast<std::int64_t>(
+      input_is_forward_domain ? output_distance : input_distance);
+
+  const std::vector<std::int64_t> fwd_strides = DomainStrides(
+      rank, fwd_embed, fwd_elem_stride, fft_length, /*conjugate_even=*/false);
+  const std::vector<std::int64_t> bwd_strides =
+      DomainStrides(rank, bwd_embed, bwd_elem_stride, fft_length,
+                    /*conjugate_even=*/conjugate_even);
+
+  // Record the layout of the input of a complex -> real transform for
+  // ProjectConjugateEvenHyperplanes(), before the switch below moves `lengths`
+  // into the descriptor.
+  if (conjugate_even && !is_forward_) {
+    conjugate_even_layout_.rank = rank;
+    for (int i = 0; i < rank; ++i) {
+      conjugate_even_layout_.lengths[i] = lengths[i];
+      conjugate_even_layout_.strides[i] = bwd_strides[i + 1];
+    }
+    conjugate_even_layout_.distance = bwd_distance;
+    conjugate_even_layout_.batch_count = batch_count;
+    conjugate_even_layout_.last_extent =
+        bwd_embed != nullptr ? static_cast<std::int64_t>(bwd_embed[rank - 1])
+                             : lengths[rank - 1] / 2 + 1;
+  }
+
+  switch (type) {
+    case fft::Type::kC2CForward:
+    case fft::Type::kC2CInverse:
+      return ConfigureDescriptor<dft::precision::SINGLE, dft::domain::COMPLEX>(
+          stream, std::move(lengths), fwd_strides, bwd_strides, fwd_distance,
+          bwd_distance, batch_count);
+    case fft::Type::kZ2ZForward:
+    case fft::Type::kZ2ZInverse:
+      return ConfigureDescriptor<dft::precision::DOUBLE, dft::domain::COMPLEX>(
+          stream, std::move(lengths), fwd_strides, bwd_strides, fwd_distance,
+          bwd_distance, batch_count);
+    case fft::Type::kR2C:
+    case fft::Type::kC2R:
+      return ConfigureDescriptor<dft::precision::SINGLE, dft::domain::REAL>(
+          stream, std::move(lengths), fwd_strides, bwd_strides, fwd_distance,
+          bwd_distance, batch_count);
+    case fft::Type::kD2Z:
+    case fft::Type::kZ2D:
+      return ConfigureDescriptor<dft::precision::DOUBLE, dft::domain::REAL>(
+          stream, std::move(lengths), fwd_strides, bwd_strides, fwd_distance,
+          bwd_distance, batch_count);
+    default:
+      return absl::InvalidArgumentError("Invalid value of fft::Type.");
+  }
+}
