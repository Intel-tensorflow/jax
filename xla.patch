+#include <cstdint>
+#include <exception>
+#include <functional>
+#include <type_traits>
+#include <sycl/sycl.hpp>
+
+// The execution policy header must precede the algorithm headers.
+#include <oneapi/dpl/execution>
+#include <oneapi/dpl/iterator>
+#include <oneapi/dpl/numeric>
+
+#include "absl/status/status.h"
+#include "absl/strings/str_cat.h"
+#include "xla/status_macros.h"
+#include "xla/stream_executor/sycl/cub_scan_kernel_sycl.h"
+
+namespace stream_executor::sycl {
+namespace {
+
+// Gives each element type its own device policy, as SYCL requires unique kernel
+// names.
+template <typename T>
+class CubScanPolicyName;
+
+// bfloat16 accumulates in float: the SYCL group scan collectives do not accept
+// it, and std::plus<bfloat16> has no constexpr sycl::known_identity.
+template <typename T>
+using ScanComputeT =
+    std::conditional_t<std::is_same_v<T, ::sycl::ext::oneapi::bfloat16>, float,
+                       T>;
+
+// Widens a bfloat16 to float by shifting its bits into the f32 field. bfloat16
+// is exactly the top 16 bits of an f32, so this is bit-identical to the
+// conversion operator but much faster on the scan.
+struct BF16ToFloat {
+  float operator()(uint16_t bits) const {
+    return ::sycl::bit_cast<float>(static_cast<uint32_t>(bits) << 16);
+  }
+};
+
+// Scans every row with a single segmented scan keyed by row index. One scan per
+// row would serialize `column_length` device launches.
+template <typename T>
+absl::Status ScanRows(const T* d_in, T* d_out, int64_t row_length,
+                      int64_t column_length, ::sycl::queue* stream) {
+  using ComputeT = ScanComputeT<T>;
+  const int64_t num_elements = row_length * column_length;
+  try {
+    auto policy =
+        oneapi::dpl::execution::make_device_policy<CubScanPolicyName<T>>(
+            *stream);
+
+    // Equal adjacent keys delimit one scan segment.
+    auto keys = oneapi::dpl::make_transform_iterator(
+        oneapi::dpl::counting_iterator<int64_t>(0),
+        [row_length](int64_t i) { return i / row_length; });
+
+    if constexpr (std::is_same_v<ComputeT, T>) {
+      oneapi::dpl::inclusive_scan_by_segment(policy, keys, keys + num_elements,
+                                             d_in, d_out,
+                                             std::equal_to<int64_t>(),
+                                             std::plus<T>());
+    } else {
+      // Promote on load; the store rounds the running sum back to bfloat16.
+      auto values = oneapi::dpl::make_transform_iterator(
+          reinterpret_cast<const uint16_t*>(d_in), BF16ToFloat{});
+      oneapi::dpl::inclusive_scan_by_segment(policy, keys, keys + num_elements,
+                                             values, d_out,
+                                             std::equal_to<int64_t>(),
+                                             std::plus<ComputeT>());
+    }
+    // oneDPL's algorithms are blocking, so the scan has already completed. The
+    // wait rethrows anything the queue reported asynchronously, which `wait()`
+    // would instead route to the queue's async handler.
+    stream->wait_and_throw();
+    return absl::OkStatus();
+  } catch (const ::sycl::exception& e) {
+    return absl::InternalError(absl::StrCat(
+        "Failed to run the oneDPL inclusive scan, SYCL error: ", e.what()));
+  } catch (const std::exception& e) {
+    return absl::InternalError(
+        absl::StrCat("Failed to run the oneDPL inclusive scan: ", e.what()));
+  } catch (...) {
+    return absl::InternalError(
+        "Failed to run the oneDPL inclusive scan: unknown exception");
+  }
+}
+
+}  // namespace
+
+template <typename T>
+absl::Status CubScan(const void* d_in, void* d_out, int64_t vector_length,
+                     int64_t row_length, int64_t column_length,
+                     CubScanKind kind, bool is_reverse, ::sycl::queue* stream) {
+  // Unsupported configurations that ScanRewriter can still emit: reject them
+  // as unimplemented so the caller can tell them apart from a real failure.
+  // TODO(intel-tf): support reverse scans, and the other CubScanKind values as
+  // ScanRewriter starts emitting them.
+  if (kind != CubScanKind::kSum) {
+    return absl::UnimplementedError("Only the SUM scan kind is supported");
+  }
+  if (is_reverse) {
+    return absl::UnimplementedError("Only a forward scan is supported");
+  }
+
+  // ScanRewriter only emits a custom call when the scan dimension is minormost,
+  // so the rows are contiguous and there is nothing to vectorize over.
+  TF_RET_CHECK(vector_length == 1)
+      << "Only vector_length = 1 is supported, got " << vector_length;
+  TF_RET_CHECK(stream != nullptr) << "SYCL queue cannot be null";
+  TF_RET_CHECK(row_length >= 0 && column_length >= 0)
+      << "row_length (" << row_length << ") and column_length ("
+      << column_length << ") must be non-negative";
+
+  if (row_length == 0 || column_length == 0) {
+    return absl::OkStatus();
+  }
+  return ScanRows<T>(static_cast<const T*>(d_in), static_cast<T*>(d_out),
+                     row_length, column_length, stream);
+}
+
+#define XLA_CUB_INSTANTIATE_SCAN(type)                                      \
+  template absl::Status CubScan<type>(const void*, void*, int64_t, int64_t, \
+                                     int64_t, CubScanKind, bool,            \
+                                     ::sycl::queue*)
+
+// Floating point types.
+XLA_CUB_INSTANTIATE_SCAN(::sycl::ext::oneapi::bfloat16);
+XLA_CUB_INSTANTIATE_SCAN(::sycl::half);
+XLA_CUB_INSTANTIATE_SCAN(float);
+XLA_CUB_INSTANTIATE_SCAN(double);
+
+// Signed integer types.
+XLA_CUB_INSTANTIATE_SCAN(int8_t);
+XLA_CUB_INSTANTIATE_SCAN(int16_t);
+XLA_CUB_INSTANTIATE_SCAN(int32_t);
+XLA_CUB_INSTANTIATE_SCAN(int64_t);
+
+// Unsigned integer types.
+XLA_CUB_INSTANTIATE_SCAN(uint8_t);
+XLA_CUB_INSTANTIATE_SCAN(uint16_t);
+XLA_CUB_INSTANTIATE_SCAN(uint32_t);
+XLA_CUB_INSTANTIATE_SCAN(uint64_t);
+
+#undef XLA_CUB_INSTANTIATE_SCAN
+
+}  // namespace stream_executor::sycl
