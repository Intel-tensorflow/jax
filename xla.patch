+#include "xla/stream_executor/sycl/cub_scan_kernel_sycl.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <sycl/sycl.hpp>
+
+#include "absl/status/status.h"
+#include "absl/status/status_macros.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/str_cat.h"
+#include "xla/backends/gpu/ffi.h"
+#include "xla/ffi/ffi.h"
+#include "xla/ffi/ffi_api.h"  // IWYU pragma: keep
+#include "xla/primitive_util.h"
+#include "xla/service/gpu/cublas_cudnn.h"
+#include "xla/xla_data.pb.h"
+
+XLA_FFI_REGISTER_ENUM_ATTR_DECODING(stream_executor::sycl::CubScanKind);
+XLA_FFI_REGISTER_ENUM_ATTR_DECODING(xla::PrimitiveType);
+
+namespace stream_executor::sycl {
+namespace {
+
+namespace ffi = ::xla::ffi;
+
+using ScanFn = absl::Status (*)(const void* d_in, void* d_out,
+                                int64_t vector_length, int64_t row_length,
+                                int64_t column_length, CubScanKind kind,
+                                bool is_reverse, ::sycl::queue* stream);
+
+absl::StatusOr<ScanFn> GetScanFn(xla::PrimitiveType element_type) {
+  switch (element_type) {
+    case xla::BF16:
+      return CubScan<::sycl::ext::oneapi::bfloat16>;
+    case xla::F16:
+      return CubScan<::sycl::half>;
+    case xla::F32:
+      return CubScan<float>;
+    case xla::F64:
+      return CubScan<double>;
+    case xla::S8:
+      return CubScan<int8_t>;
+    case xla::S16:
+      return CubScan<int16_t>;
+    case xla::S32:
+      return CubScan<int32_t>;
+    case xla::S64:
+      return CubScan<int64_t>;
+    case xla::U8:
+      return CubScan<uint8_t>;
+    case xla::U16:
+      return CubScan<uint16_t>;
+    case xla::U32:
+      return CubScan<uint32_t>;
+    case xla::U64:
+      return CubScan<uint64_t>;
+    default:
+      return absl::InvalidArgumentError(absl::StrCat(
+          "Unsupported element type for CUB scan: ",
+          xla::primitive_util::LowercasePrimitiveTypeName(element_type)));
+  }
+}
+
+absl::Status CubScanExecute(ffi::AnyBuffer d_in,
+                            ffi::Result<ffi::AnyBuffer> d_out,
+                            ffi::Result<ffi::BufferR1<xla::U8>> d_temp_storage,
+                            int64_t vector_length, int64_t row_length,
+                            int64_t column_length, CubScanKind kind,
+                            bool is_reverse, ::sycl::queue* stream) {
+  ABSL_RETURN_IF_ERROR(
+      ffi::Verify("output", *d_out, ffi::match::Buffer().Like(d_in)));
+
+  ABSL_ASSIGN_OR_RETURN(ScanFn fn, GetScanFn(d_in.element_type()));
+  return fn(d_in.untyped_data(), d_out->untyped_data(), vector_length,
+            row_length, column_length, kind, is_reverse, stream);
+}
+
+// oneDPL allocates its own temporaries, so no caller scratch is needed.
+absl::StatusOr<std::unique_ptr<int64_t>> CubScanInstantiate(
+    xla::PrimitiveType element_type, int64_t vector_length, int64_t row_length,
+    int64_t column_length, CubScanKind kind, bool is_reverse) {
+  ABSL_RETURN_IF_ERROR(GetScanFn(element_type).status());
+  return std::make_unique<int64_t>(0);
+}
+
+// The scratch-size target only runs its instantiate hook.
+absl::Status CubScanDummyExecute() {
+  return absl::InternalError("Dummy execute handler should not be called");
+}
+
+}  // namespace
+
+XLA_FFI_DEFINE_HANDLER(kCubScanExecute, CubScanExecute,
+                       ffi::Ffi::Bind()
+                           .Arg<ffi::AnyBuffer>()          // d_in
+                           .Ret<ffi::AnyBuffer>()          // d_out
+                           .Ret<ffi::BufferR1<xla::U8>>()  // d_temp_storage
+                           .Attr<int64_t>("vector_length")
+                           .Attr<int64_t>("row_length")
+                           .Attr<int64_t>("column_length")
+                           .Attr<CubScanKind>("kind")
+                           .Attr<bool>("is_reverse")
+                           .Ctx<ffi::PlatformStream<::sycl::queue*>>(),
+                       {ffi::Traits::kCmdBufferCompatible});
+
+XLA_FFI_REGISTER_HANDLER(ffi::GetXlaFfiApi(),
+                         xla::gpu::kCubDeviceScanTarget.data(), "SYCL",
+                         {/*instantiate=*/nullptr, /*prepare=*/nullptr,
+                          /*initialize=*/nullptr,
+                          /*execute=*/kCubScanExecute});
+
+XLA_FFI_DEFINE_HANDLER(kCubScanInstantiate, CubScanInstantiate,
+                       ffi::Ffi::BindInstantiate()
+                           .Attr<xla::PrimitiveType>("element_type")
+                           .Attr<int64_t>("vector_length")
+                           .Attr<int64_t>("row_length")
+                           .Attr<int64_t>("column_length")
+                           .Attr<CubScanKind>("kind")
+                           .Attr<bool>("is_reverse"));
+
+XLA_FFI_DEFINE_HANDLER(kCubScanDummyExecute, CubScanDummyExecute,
+                       ffi::Ffi::Bind());
+
+XLA_FFI_REGISTER_HANDLER(
+    ffi::GetXlaFfiApi(),
+    xla::gpu::kCubDeviceScanUnassignedScratchSizeTarget.data(), "SYCL",
+    {/*instantiate=*/kCubScanInstantiate, /*prepare=*/nullptr,
+     /*initialize=*/nullptr, /*execute=*/kCubScanDummyExecute});
+
+}  // namespace stream_executor::sycl
