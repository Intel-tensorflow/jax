+
+#ifndef XLA_STREAM_EXECUTOR_SYCL_ONEMKL_BLAS_H_
+#define XLA_STREAM_EXECUTOR_SYCL_ONEMKL_BLAS_H_
+
+#include "absl/status/status_macros.h"
+#include "oneapi/mkl.hpp"
+#include "xla/service/gpu/matmul_utils.h"
+#include "xla/stream_executor/gpu/gpu_blas_lt.h"
+#include "xla/stream_executor/stream_executor.h"
+#include "xla/stream_executor/sycl/onemkl_util.h"
+
+namespace stream_executor {
+namespace sycl {
+
+namespace {
+// Helper functions transforming blas arguments into oneMKL arguments.
+
+oneapi::mkl::uplo MklUpperLower(blas::UpperLower uplo) {
+  return (uplo == blas::UpperLower::kUpper) ? oneapi::mkl::uplo::upper
+                                            : oneapi::mkl::uplo::lower;
+}
+
+oneapi::mkl::diag MklDiagonal(blas::Diagonal diag) {
+  return (diag == blas::Diagonal::kUnit) ? oneapi::mkl::diag::unit
+                                         : oneapi::mkl::diag::nonunit;
+}
+
+oneapi::mkl::side MklSide(blas::Side side) {
+  return (side == blas::Side::kLeft) ? oneapi::mkl::side::left
+                                     : oneapi::mkl::side::right;
+}
+
+oneapi::mkl::transpose MklTranspose(blas::Transpose transa) {
+  if (transa == blas::Transpose::kTranspose)
+    return oneapi::mkl::transpose::trans;
+  else if (transa == blas::Transpose::kNoTranspose)
+    return oneapi::mkl::transpose::nontrans;
+  else
+    return oneapi::mkl::transpose::conjtrans;
+}
+}  // namespace
+
+template <typename CType>
+absl::Status ComplexMatmulImpl(const gpu::GemmConfig& config, Stream* stream,
+                               const gpu::BlasLt::MemoryArgs& args) {
+  gpu::MatrixLayout lhs = config.lhs_layout, rhs = config.rhs_layout,
+                    out = config.output_layout;
+  // cublasLt matmul requires batch sizes to be equal. If only one operand has a
+  // batch, the other will be broadcast (as its batch_stride == 0).
+  size_t batch_size = std::max(lhs.batch_size, rhs.batch_size);
+  lhs.batch_size = batch_size;
+  rhs.batch_size = batch_size;
+
+  DeviceAddressBase a_buf = args.a, b_buf = args.b;
+  bool must_swap_operands = gpu::MakeOutputColumnMajor(lhs, rhs, out);
+  if (must_swap_operands) {
+    std::swap(a_buf, b_buf);
+  }
+
+  auto transpose_of = [](const gpu::MatrixLayout& l) {
+    return l.order == gpu::MatrixLayout::Order::kColumnMajor
+               ? blas::Transpose::kNoTranspose
+               : blas::Transpose::kTranspose;
+  };
+  blas::Transpose trans_a = transpose_of(lhs), trans_b = transpose_of(rhs);
+
+  const uint64_t m = out.num_rows, n = out.num_cols, k = lhs.num_cols;
+  const int lda = static_cast<int>(lhs.leading_dim_stride),
+            ldb = static_cast<int>(rhs.leading_dim_stride),
+            ldc = static_cast<int>(out.leading_dim_stride);
+
+  // oneMKL overwrites the buffer c with the results. If c and d are not the
+  // same, intialize d with c. Initialization is not needed if beta == 0.0
+  DeviceAddressBase out_buf = args.d;
+  if (config.beta != 0.0 && args.c.opaque() != args.d.opaque()) {
+    ABSL_RETURN_IF_ERROR(stream->Memcpy(&out_buf, args.c, out_buf.size()));
+  }
+
+  ::sycl::queue* stream_queue =
+      absl::bit_cast<::sycl::queue*>(stream->platform_specific_handle().stream);
+
+  auto a = reinterpret_cast<const CType*>(a_buf.opaque());
+  auto b = reinterpret_cast<const CType*>(b_buf.opaque());
+  auto c = reinterpret_cast<CType*>(out_buf.opaque());
+  CType alpha(config.alpha.real(), config.alpha.imag());
+  CType beta(config.beta);
+  absl::StatusOr<::sycl::event> status =
+      (batch_size != 1)
+          ? ExecMklFunc([&]{return oneapi::mkl::blas::gemm_batch(*stream_queue,
+                        MklTranspose(trans_a), MklTranspose(trans_b), m, n, k,
+                        alpha, a, lda, lhs.batch_stride, b, ldb,
+                        rhs.batch_stride, beta, c, ldc, out.batch_stride,
+                        batch_size);})
+          : ExecMklFunc([&]{return oneapi::mkl::blas::gemm( *stream_queue,
+                        MklTranspose(trans_a), MklTranspose(trans_b), m, n, k,
+                        alpha, a, lda, b, ldb, beta, c, ldc);});
+  return status.status();
+}
+
+template <typename T>
+bool TrsmImpl(Stream* stream, blas::Side side, blas::UpperLower uplo,
+              blas::Transpose transa, blas::Diagonal diag, int64_t m, int64_t n,
+              T alpha, const T* a, int64_t lda, T* b, int64_t ldb) {
+  ::sycl::queue* q =
+      absl::bit_cast<::sycl::queue*>(stream->platform_specific_handle().stream);
+  absl::StatusOr<::sycl::event> status =
+      ExecMklFunc([&]{ return oneapi::mkl::blas::trsm(*q, MklSide(side),
+                  MklUpperLower(uplo), MklTranspose(transa), MklDiagonal(diag),
+                  m, n, alpha, a, lda, b, ldb);});
+  if (status.ok()) {
+    return true;
+  }
+  LOG(ERROR) << status.status();
+  return false;
+}
+
+template <class T>
+bool TrsmBatchImpl(Stream* stream, blas::Side side, blas::UpperLower uplo,
+                   blas::Transpose transa, blas::Diagonal diag, int64_t m,
+                   int64_t n, T alpha, const T** a, int64_t lda, T** b,
+                   int64_t ldb, int64_t batch_count) {
+  struct MklTrsmArgs {
+    MklTrsmArgs(oneapi::mkl::side side_info, oneapi::mkl::uplo uplo_info,
+                oneapi::mkl::transpose transpose_info,
+                oneapi::mkl::diag diag_info, int64_t m, int64_t n,
+                std::int64_t lda, std::int64_t ldb, std::int64_t groupsize_info)
+        : side_info(side_info),
+          uplo_info(uplo_info),
+          transpose_info(transpose_info),
+          diag_info(diag_info),
+          m(m),
+          n(n),
+          lda(lda),
+          ldb(ldb),
+          groupsize_info(groupsize_info) {}
+    oneapi::mkl::side side_info;
+    oneapi::mkl::uplo uplo_info;
+    oneapi::mkl::transpose transpose_info;
+    oneapi::mkl::diag diag_info;
+    std::int64_t m;
+    std::int64_t n;
+    std::int64_t lda;
+    std::int64_t ldb;
+    std::int64_t groupsize_info;
+  };
+
+  ::sycl::queue* q =
+      absl::bit_cast<::sycl::queue*>(stream->platform_specific_handle().stream);
+  // SYCL doesn't allow unique ptrs in some lambda captures, using raw pointers
+  // to pass args to Trsm. onemkl function execute asyncronously, we need to
+  // submit a  SYCL task to delete the pointers.
+  auto alpha_ptr = new T(alpha);
+  auto mkl_trsm_args_ptr =
+      new MklTrsmArgs(MklSide(side), MklUpperLower(uplo), MklTranspose(transa),
+                      MklDiagonal(diag), m, n, lda, ldb, batch_count);
+  absl::StatusOr<::sycl::event> status_or_event = ExecMklFunc(
+      [&] { return oneapi::mkl::blas::trsm_batch(*q,
+      &(mkl_trsm_args_ptr->side_info), &(mkl_trsm_args_ptr->uplo_info),
+      &(mkl_trsm_args_ptr->transpose_info), &(mkl_trsm_args_ptr->diag_info),
+      &(mkl_trsm_args_ptr->m), &(mkl_trsm_args_ptr->n), alpha_ptr, a,
+      &(mkl_trsm_args_ptr->lda), b, &(mkl_trsm_args_ptr->ldb), 1,
+      &(mkl_trsm_args_ptr->groupsize_info));});
+  if (!status_or_event.ok()) {
+    // Mkl call failed, clean up and exit.
+    LOG(ERROR) << status_or_event.status();
+    delete mkl_trsm_args_ptr;
+    delete alpha_ptr;
+    return false;
+  }
+  // submit task to delete args_ptr after mkl call is completed.
+  ::sycl::event e = *status_or_event;
+  q->submit([&](::sycl::handler& cgh) {
+    cgh.depends_on(e);
+    cgh.host_task([mkl_trsm_args_ptr, alpha_ptr] {
+      delete mkl_trsm_args_ptr;
+      delete alpha_ptr;
+    });
+  });
+  return true;
+}
+
