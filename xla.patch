+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+#include <gtest/gtest.h>
+#include "absl/strings/string_view.h"
+#include "xla/error_spec.h"
+#include "xla/tests/hlo_pjrt_interpreter_reference_mixin.h"
+#include "xla/tests/hlo_test_base.h"
+
+namespace xla::gpu {
+namespace {
+
+// Compares the oneMKL DFT transforms against the HLO evaluator, which defines
+// what an XLA FFT computes. The inputs are random, so the input of a complex ->
+// real transform is not conjugate-even.
+using FftSyclTest = HloInterpreterReferenceMixin<HloTestBase>;
+
+TEST_F(FftSyclTest, Fft) {
+  absl::string_view hlo = R"(
+  HloModule fft
+
+  ENTRY main {
+    input = c64[3,20]{1,0} parameter(0)
+    ROOT fft = c64[3,20]{1,0} fft(input), fft_type=FFT, fft_length={20}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, Ifft) {
+  absl::string_view hlo = R"(
+  HloModule ifft
+
+  ENTRY main {
+    input = c64[3,20]{1,0} parameter(0)
+    ROOT fft = c64[3,20]{1,0} fft(input), fft_type=IFFT, fft_length={20}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, Rfft) {
+  absl::string_view hlo = R"(
+  HloModule rfft
+
+  ENTRY main {
+    input = f32[3,20]{1,0} parameter(0)
+    ROOT fft = c64[3,11]{1,0} fft(input), fft_type=RFFT, fft_length={20}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, Rfft2D) {
+  absl::string_view hlo = R"(
+  HloModule rfft2d
+
+  ENTRY main {
+    input = f32[4,8]{1,0} parameter(0)
+    ROOT fft = c64[4,5]{1,0} fft(input), fft_type=RFFT, fft_length={4,8}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+// XLA drops the imaginary parts of the DC and the Nyquist element of the input.
+// oneMKL uses them, so this fails without the fix-up in sycl_fft.cc.
+TEST_F(FftSyclTest, IrfftEvenLength) {
+  absl::string_view hlo = R"(
+  HloModule irfft
+
+  ENTRY main {
+    input = c64[11]{0} parameter(0)
+    ROOT fft = f32[20]{0} fft(input), fft_type=IRFFT, fft_length={20}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+// An odd length has no Nyquist element, so only DC is fixed up.
+TEST_F(FftSyclTest, IrfftOddLength) {
+  absl::string_view hlo = R"(
+  HloModule irfft_odd
+
+  ENTRY main {
+    input = c64[6]{0} parameter(0)
+    ROOT fft = f32[11]{0} fft(input), fft_type=IRFFT, fft_length={11}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, IrfftBatched) {
+  absl::string_view hlo = R"(
+  HloModule irfft_batched
+
+  ENTRY main {
+    input = c64[3,11]{1,0} parameter(0)
+    ROOT fft = f32[3,20]{1,0} fft(input), fft_type=IRFFT, fft_length={20}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+// For a rank > 1 transform the fix-up covers the whole DC and Nyquist
+// hyperplane, not just one element of it.
+TEST_F(FftSyclTest, Irfft2DEvenLastLength) {
+  absl::string_view hlo = R"(
+  HloModule irfft2d
+
+  ENTRY main {
+    input = c64[4,5]{1,0} parameter(0)
+    ROOT fft = f32[4,8]{1,0} fft(input), fft_type=IRFFT, fft_length={4,8}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, Irfft2DOddLastLength) {
+  absl::string_view hlo = R"(
+  HloModule irfft2d_odd
+
+  ENTRY main {
+    input = c64[4,4]{1,0} parameter(0)
+    ROOT fft = f32[4,7]{1,0} fft(input), fft_type=IRFFT, fft_length={4,7}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+TEST_F(FftSyclTest, Irfft3DBatched) {
+  absl::string_view hlo = R"(
+  HloModule irfft3d
+
+  ENTRY main {
+    input = c64[2,3,4,5]{3,2,1,0} parameter(0)
+    ROOT fft = f32[2,3,4,8]{3,2,1,0} fft(input), fft_type=IRFFT, fft_length={3,4,8}
+  })";
+  EXPECT_TRUE(RunAndCompare(hlo, ErrorSpec{1e-4, 1e-4}));
+}
+
+// No double precision tests: the HLO evaluator only takes c64 and f32 (see
+// CheckParameters() in hlo_evaluator.cc), so there is no reference for them.
+
+}  // namespace
+}  // namespace xla::gpu
