+
+#ifndef XLA_STREAM_EXECUTOR_SYCL_ONEDPL_SORT_TRAITS_SYCL_H_
+#define XLA_STREAM_EXECUTOR_SYCL_ONEDPL_SORT_TRAITS_SYCL_H_
+
+#include <cstdint>
+#include <type_traits>
+#include <sycl/sycl.hpp>
+
+// Adds the radix sort traits oneDPL is missing for 16-bit floats. Must be
+// included before the oneDPL kernel_templates header.
+#include <oneapi/dpl/execution>
+#include <oneapi/dpl/experimental/kt/internal/radix_sort_utils.h>
+
+namespace oneapi::dpl::experimental::kt::gpu::__impl {
+
+// True for the 16-bit float types that oneDPL's own overloads do not cover.
+template <typename _T>
+inline constexpr bool __xla_is_16bit_float_v =
+    std::is_same_v<_T, ::sycl::half> ||
+    std::is_same_v<_T, ::sycl::ext::oneapi::bfloat16>;
+
+// Identity padding value for incomplete blocks. Every exponent and mantissa bit
+// is set so the identity always sorts to the end at each radix stage.
+template <typename _T, bool __is_ascending,
+          std::enable_if_t<__xla_is_16bit_float_v<_T>, int> = 0>
+constexpr _T
+__sort_identity()
+{
+    if constexpr (__is_ascending)
+        return ::sycl::bit_cast<_T>(std::uint16_t(0x7FFFu));
+    else
+        return ::sycl::bit_cast<_T>(std::uint16_t(0xFFFFu));
+}
+
+// Flips the sign bit for positives and all bits for negatives, so the unsigned
+// bit pattern orders exactly like the float value.
+template <bool __is_ascending, typename _Float,
+          std::enable_if_t<__xla_is_16bit_float_v<_Float>, int> = 0>
+std::uint16_t
+__order_preserving_cast_scalar(_Float __src)
+{
+    std::uint16_t __uint16_src = ::sycl::bit_cast<std::uint16_t>(__src);
+    std::uint16_t __mask;
+    bool __sign_bit_is_zero = (__uint16_src >> 15 == 0);
+    if constexpr (__is_ascending)
+    {
+        __mask = __sign_bit_is_zero ? std::uint16_t(0x8000u) : std::uint16_t(0xFFFFu);
+    }
+    else
+    {
+        __mask = __sign_bit_is_zero ? std::uint16_t(0x7FFFu) : std::uint16_t(0);
+    }
+    return __uint16_src ^ __mask;
+}
+
+}  // namespace oneapi::dpl::experimental::kt::gpu::__impl
+
+#endif  // XLA_STREAM_EXECUTOR_SYCL_ONEDPL_SORT_TRAITS_SYCL_H_
