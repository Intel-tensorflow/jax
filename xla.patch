+#ifndef XLA_STREAM_EXECUTOR_SYCL_CUB_SCAN_KERNEL_SYCL_H_
+#define XLA_STREAM_EXECUTOR_SYCL_CUB_SCAN_KERNEL_SYCL_H_
+
+#include <cstdint>
+#include <sycl/sycl.hpp>
+
+#include "absl/status/status.h"
+
+namespace stream_executor::sycl {
+
+enum class CubScanKind { kInvalid, kSum };
+
+// Inclusive scan of `d_in` into `d_out`. The input is treated as
+// `column_length` rows of `row_length` contiguous elements, scanned along each
+// row. Implemented in cub_scan_kernel_sycl_impl.dp.cpp.
+template <typename T>
+absl::Status CubScan(const void* d_in, void* d_out, int64_t vector_length,
