+}  // namespace
+
+std::unique_ptr<fft::Plan> SyclFft::CreateBatchedPlanWithScratchAllocator(
+    Stream* stream, int rank, std::uint64_t* fft_length,
+    std::uint64_t* input_embed, std::uint64_t input_stride,
+    std::uint64_t input_distance, std::uint64_t* output_embed,
+    std::uint64_t output_stride, std::uint64_t output_distance, fft::Type type,
+    bool in_place_fft, int batch_count, ScratchAllocator* scratch_allocator) {
+  auto fft_plan = std::make_unique<SyclFftPlan>();
+  // oneMKL manages the work area of a descriptor itself, so the allocator is
+  // only used for the input copy of a complex -> real transform.
+  fft_plan->set_scratch_allocator(scratch_allocator);
+  absl::Status status = fft_plan->Initialize(
+      stream, rank, fft_length, input_embed, input_stride, input_distance,
+      output_embed, output_stride, output_distance, type, in_place_fft,
+      batch_count);
+  if (!status.ok()) {
+    LOG(ERROR) << "Failed to initialize batched oneMKL DFT plan: "
+               << status.message() << ". Initialize params: rank: " << rank
+               << " fft_length: " << *fft_length
+               << " input_stride: " << input_stride
+               << " input_distance: " << input_distance
+               << " output_stride: " << output_stride
+               << " output_distance: " << output_distance
+               << " batch_count: " << batch_count;
+    return nullptr;
+  }
+  return fft_plan;
+}
+
+void SyclFft::UpdatePlanWithScratchAllocator(
+    Stream* stream, fft::Plan* plan, ScratchAllocator* scratch_allocator) {
+  // oneMKL allocates its own work area, so the allocator is only kept for the
+  // input copy of a complex -> real transform, and has to be replaced before
+  // every execution.
+  SyclFftPlan* sycl_fft_plan = dynamic_cast<SyclFftPlan*>(plan);
+  if (sycl_fft_plan == nullptr) {
+    LOG(ERROR) << "The passed-in plan is not a SyclFftPlan object.";
+    return;
+  }
+  sycl_fft_plan->set_scratch_allocator(scratch_allocator);
+}
+
+template <typename InputT, typename OutputT>
+bool SyclFft::DoFftInternal(Stream* stream, fft::Plan* plan,
+                            const DeviceAddress<InputT>& input,
+                            DeviceAddress<OutputT>* output) {
+  SyclFftPlan* sycl_fft_plan = dynamic_cast<SyclFftPlan*>(plan);
+  if (sycl_fft_plan == nullptr) {
+    LOG(ERROR) << "The passed-in plan is not a SyclFftPlan object.";
+    return false;
+  }
+
+  using Traits = OneMklFftTraits<InputT, OutputT>;
+  auto* descriptor =
+      sycl_fft_plan->GetDescriptor<Traits::kPrecision, Traits::kDomain>();
+  if (descriptor == nullptr) {
+    LOG(ERROR) << "The oneMKL DFT plan was created for a different precision "
+                  "or domain than the one the transform is run with.";
+    return false;
+  }
+
+  if (absl::Status status = sycl_fft_plan->CommitOn(SyclQueue(stream));
+      !status.ok()) {
+    LOG(ERROR) << status.message();
+    return false;
+  }
+
+  constexpr Direction kDirection = Traits::kDirection;
+  if constexpr (kDirection != Direction::kFromPlan) {
+    if (sycl_fft_plan->is_forward() != (kDirection == Direction::kForward)) {
+      LOG(ERROR) << "The oneMKL DFT plan was created for the direction "
+                    "opposite to the one the element types of the transform "
+                    "imply.";
+      return false;
+    }
+  }
+
+  // A complex -> real transform runs on a fixed-up copy of its input to agree
+  // with the other XLA backends (see ProjectConjugateEvenHyperplanes()); every
+  // other transform reads the input as it is.
+  DeviceAddress<InputT> transform_input = input;
+  if constexpr (kDirection == Direction::kBackward) {
+    transform_input =
+        ConjugateEvenInput(stream, input, sycl_fft_plan->scratch_allocator(),
+                           sycl_fft_plan->conjugate_even_layout());
+  }
+
+  // The queues created by SyclStream are in-order, so the transform is ordered
+  // against the rest of the stream without tracking events explicitly.
+  auto* in = const_cast<InputT*>(GpuMemory(transform_input));
+  auto* out = GpuMemoryMutable(output);
+  auto compute = [&](auto&& mkl_func) {
+    absl::StatusOr<::sycl::event> event =
+        ExecMklFunc([&] { return mkl_func(*descriptor, in, out); });
+    if (!event.ok()) {
+      LOG(ERROR) << "Failed to run the oneMKL DFT routine: "
+                 << event.status().message();
+      return false;
+    }
+    return true;
+  };
+
+  // Generic lambdas, so a body is only instantiated for the direction that is
+  // actually taken below. Only the routine that matches the element types may be
+  // instantiated: oneMKL does not provide a complex -> real compute_forward() or
+  // a real -> complex compute_backward(), and referencing either of them fails
+  // to link.
+  auto forward = [](auto&&... args) {
+    return dft::compute_forward(std::forward<decltype(args)>(args)...);
+  };
+  auto backward = [](auto&&... args) {
+    return dft::compute_backward(std::forward<decltype(args)>(args)...);
+  };
+
+  if constexpr (kDirection == Direction::kForward) {
+    return compute(forward);
+  } else if constexpr (kDirection == Direction::kBackward) {
+    return compute(backward);
+  } else {
+    static_assert(kDirection == Direction::kFromPlan);
+    return sycl_fft_plan->is_forward() ? compute(forward) : compute(backward);
+  }
+}
+
+#define STREAM_EXECUTOR_SYCL_DEFINE_FFT(__type)                       \
+  bool SyclFft::DoFft(Stream* stream, fft::Plan* plan,                \
+                      const DeviceAddress<std::complex<__type>>& input, \
+                      DeviceAddress<std::complex<__type>>* output) {  \
+    return DoFftInternal(stream, plan, input, output);                \
+  }                                                                   \
+  bool SyclFft::DoFft(Stream* stream, fft::Plan* plan,                \
+                      const DeviceAddress<__type>& input,             \
+                      DeviceAddress<std::complex<__type>>* output) {  \
+    return DoFftInternal(stream, plan, input, output);                \
+  }                                                                   \
+  bool SyclFft::DoFft(Stream* stream, fft::Plan* plan,                \
+                      const DeviceAddress<std::complex<__type>>& input, \
+                      DeviceAddress<__type>* output) {                \
+    return DoFftInternal(stream, plan, input, output);                \
+  }
+
+STREAM_EXECUTOR_SYCL_DEFINE_FFT(float)
+STREAM_EXECUTOR_SYCL_DEFINE_FFT(double)
+
+#undef STREAM_EXECUTOR_SYCL_DEFINE_FFT
+
+void initialize_onemkl_fft() {
+  absl::Status status =
+      PluginRegistry::Instance()->RegisterFactory<PluginRegistry::FftFactory>(
+          sycl::kSyclPlatformId, "oneMKL DFT",
+          [](StreamExecutor* parent) -> fft::FftSupport* {
+            return new sycl::SyclFft(parent);
+          });
+  if (!status.ok()) {
+    LOG(ERROR) << "Unable to register oneMKL DFT factory: " << status.message();
+  }
+}
+
+}  // namespace sycl
+}  // namespace stream_executor
+
+STREAM_EXECUTOR_REGISTER_MODULE_INITIALIZER(register_onemkl_fft, {
+  stream_executor::sycl::initialize_onemkl_fft();
+});
