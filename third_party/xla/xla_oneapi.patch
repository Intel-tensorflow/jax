+namespace {
+// Parses an Xe device of the format `Xe<num><P>` and returns its
+// encoded device arch value used by oneAPI compute capability.
+uint32_t XeDeviceArchValue(absl::string_view arch) {
+  if (!absl::StartsWith(arch, "Xe")) {
+    return 0;
+  }
+  int offset = absl::EndsWith(arch, "P") ? 1 : 0;
+  uint32_t value = 0;
+  uint32_t size = arch.size() - 2 - offset;
+  if (size <= 0 || !absl::SimpleAtoi(arch.substr(2, size), &value)) {
+    return 0;
+  }
+  return OneAPIComputeCapability::XeGenerationFromXeValue(value + 0.5 * offset);
+}
+}  // namespace
+
 template <std::size_t... I>
 OneAPIDeviceType OneAPIComputeCapability::InferDeviceType(
     uint32_t generation, uint32_t version, std::index_sequence<I...>) {
@@ -156,6 +173,13 @@ OneAPIComputeCapability::OneAPIComputeCapability(uint32_t generation,
 OneAPIComputeCapability::OneAPIComputeCapability(absl::string_view arch,
                                                  absl::string_view variant)
     : OneAPIComputeCapability([&]() -> uint32_t {
+        // If `arch` is in Xe format `Xe<num><P>`, treat the device as unknown
+        // and construct ip_version from encoded generation and unknown variant
+        // value.
+        uint32_t xe_val = XeDeviceArchValue(arch);
+        if (xe_val != 0) {
+          return (xe_val << 22) | (kUnknownVariantValue << 14);
+        }
         OneAPIDeviceType type = NameToDeviceType(arch);
         auto ip_version = static_cast<uint32_t>(type);
         if ((ip_version & 0x3fff) >= std::size(kKnownDevices)) {
@@ -178,8 +202,8 @@ std::string OneAPIComputeCapability::architecture() const {
   if (generation_ == 0) {
     return "Unknown";
   }
-  return absl::StrCat("Xe", generation_ / 10,
-                      (generation_ % 10 == 5) ? "P" : "");
+  const bool has_p_suffix = (generation_ % 10 == 5) || (generation_ == 0x11);
+  return absl::StrCat("Xe", generation_ / 10, has_p_suffix ? "P" : "");
 }
 
