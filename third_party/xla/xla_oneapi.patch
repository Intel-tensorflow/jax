+#ifndef XLA_STREAM_EXECUTOR_SYCL_CUB_SCAN_KERNEL_SYCL_H_
+#define XLA_STREAM_EXECUTOR_SYCL_CUB_SCAN_KERNEL_SYCL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <sycl/sycl.hpp>
+
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "xla/xla_data.pb.h"
+
+namespace stream_executor::sycl {
+
+enum class CubScanKind { kInvalid, kSum };
+
+// Performs an inclusive scan of `d_in` into `d_out` on SYCL device memory. The
+// input is treated as `column_length` rows of `row_length` contiguous elements,
+// scanned along each row. oneDPL allocates its own temporaries, so
+// `d_temp_storage` is unused.
+absl::Status CubScanLaunchKernel(xla::PrimitiveType type, void* d_temp_storage,
+                                 size_t temp_bytes, const void* d_in,
+                                 void* d_out, int64_t vector_length,
+                                 int64_t row_length, int64_t column_length,
+                                 CubScanKind kind, bool is_reverse,
+                                 ::sycl::queue* stream);
+
+// Returns the scratch size the scan needs, which is always 0, or an error if
+// the scan is unsupported.
+absl::StatusOr<size_t> CubScanGetScratchSize(xla::PrimitiveType type,
+                                             int64_t vector_length,
+                                             int64_t row_length,
+                                             int64_t column_length,
+                                             CubScanKind kind, bool is_reverse);
+
+}  // namespace stream_executor::sycl
+
+#endif  // XLA_STREAM_EXECUTOR_SYCL_CUB_SCAN_KERNEL_SYCL_H_
