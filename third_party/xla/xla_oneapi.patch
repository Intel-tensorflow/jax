+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+==============================================================================*/
+
+#include <cstddef>
+#include <cstdint>
+#include <exception>
+#include <functional>
+#include <limits>
+#include <sycl/sycl.hpp>
+
+// The execution policy header must precede the algorithm headers.
+#include <oneapi/dpl/execution>
+#include <oneapi/dpl/iterator>
+#include <oneapi/dpl/numeric>
+
+#include "absl/status/status.h"
+#include "absl/status/status_macros.h"
+#include "absl/status/statusor.h"
+#include "absl/strings/str_cat.h"
+#include "xla/status_macros.h"
+#include "xla/stream_executor/sycl/cub_scan_kernel_sycl.h"
+#include "xla/xla_data.pb.h"
+
+namespace stream_executor::sycl {
+namespace {
+
+// SYCL requires unique kernel names, and oneDPL names its kernels after the
+// policy, so every element type and scan variant needs its own policy name.
+template <typename T>
+class CubScanPolicyName;
+template <typename T, typename KeyT>
+class CubSegmentedScanPolicyName;
+
+// Maps an element index to the index of its row.
+template <typename KeyT>
+struct RowIndex {
+  KeyT row_length;
+  KeyT operator()(KeyT i) const { return i / row_length; }
+};
+
+// Scans a single row with a plain scan, which oneDPL runs in a single
+// work-group kernel for small inputs and otherwise as a reduce-then-scan that
+// carries no segment flags.
+template <typename T>
+void ScanRow(const T* d_in, T* d_out, int64_t num_elements,
+             ::sycl::queue& stream) {
+  auto policy =
+      oneapi::dpl::execution::make_device_policy<CubScanPolicyName<T>>(stream);
+  oneapi::dpl::inclusive_scan(policy, d_in, d_in + num_elements, d_out,
+                              std::plus<T>());
+}
+
+// Scans every row with a single segmented scan keyed by row index. One scan per
+// row would serialize `column_length` device launches. KeyT is uint32_t when
+// every element index fits, as 64-bit division is much slower on the device.
+template <typename T, typename KeyT>
+void ScanSegmentedRows(const T* d_in, T* d_out, int64_t row_length,
+                       int64_t num_elements, ::sycl::queue& stream) {
+  auto policy = oneapi::dpl::execution::make_device_policy<
+      CubSegmentedScanPolicyName<T, KeyT>>(stream);
+
+  // Equal adjacent keys delimit one scan segment.
+  auto keys = oneapi::dpl::make_transform_iterator(
+      oneapi::dpl::counting_iterator<KeyT>(0),
+      RowIndex<KeyT>{static_cast<KeyT>(row_length)});
+  oneapi::dpl::inclusive_scan_by_segment(policy, keys, keys + num_elements,
+                                         d_in, d_out, std::equal_to<KeyT>(),
+                                         std::plus<T>());
+}
+
+template <typename T>
+absl::Status ScanRows(const T* d_in, T* d_out, int64_t row_length,
+                      int64_t column_length, ::sycl::queue* stream) {
+  const int64_t num_elements = row_length * column_length;
+  try {
+    if (column_length == 1) {
+      ScanRow(d_in, d_out, num_elements, *stream);
+    } else if (num_elements <= std::numeric_limits<uint32_t>::max()) {
+      ScanSegmentedRows<T, uint32_t>(d_in, d_out, row_length, num_elements,
+                                     *stream);
+    } else {
+      ScanSegmentedRows<T, uint64_t>(d_in, d_out, row_length, num_elements,
+                                     *stream);
+    }
+    // oneDPL's algorithms are blocking, so the scan has already completed. The
+    // wait rethrows anything the queue reported asynchronously, which `wait()`
+    // would instead route to the queue's async handler.
+    stream->wait_and_throw();
+  } catch (const std::exception& e) {
+    return absl::InternalError(
+        absl::StrCat("Failed to run the oneDPL inclusive scan: ", e.what()));
+  } catch (...) {
+    return absl::InternalError(
+        "Failed to run the oneDPL inclusive scan: unknown exception");
+  }
+  return absl::OkStatus();
+}
+
+template <typename T>
+absl::Status CubScanDispatch(size_t* temp_bytes, const T* d_in, T* d_out,
+                             int64_t vector_length, int64_t row_length,
+                             int64_t column_length, CubScanKind kind,
+                             bool is_reverse, ::sycl::queue* stream) {
+  if (kind != CubScanKind::kSum) {
+    return absl::InvalidArgumentError("Only SUM scan kind is supported.");
+  }
+  if (is_reverse) {
+    return absl::InvalidArgumentError("Only forward scan is supported.");
+  }
+  if (vector_length > 1) {
+    return absl::InvalidArgumentError("Only vector_length = 1 is supported.");
+  }
+  TF_RET_CHECK(row_length >= 0 && column_length >= 0)
+      << "row_length (" << row_length << ") and column_length ("
+      << column_length << ") must be non-negative";
+
+  // A null input and output is a request for the scratch size. oneDPL
+  // allocates its own temporaries, so the scan needs none.
+  if (d_in == nullptr && d_out == nullptr) {
+    *temp_bytes = 0;
+    return absl::OkStatus();
+  }
+
+  TF_RET_CHECK(stream != nullptr) << "SYCL queue cannot be null";
+
+  if (row_length == 0 || column_length == 0) {
+    return absl::OkStatus();
+  }
+  return ScanRows<T>(d_in, d_out, row_length, column_length, stream);
+}
+
+absl::Status CubScanDispatch(xla::PrimitiveType type, size_t* temp_bytes,
+                             const void* d_in, void* d_out,
+                             int64_t vector_length, int64_t row_length,
+                             int64_t column_length, CubScanKind kind,
+                             bool is_reverse, ::sycl::queue* stream) {
+  auto impl = [&](auto value) {
+    using T = decltype(value);
+    return CubScanDispatch<T>(temp_bytes, static_cast<const T*>(d_in),
+                              static_cast<T*>(d_out), vector_length, row_length,
+                              column_length, kind, is_reverse, stream);
+  };
+  switch (type) {
+    case xla::PrimitiveType::BF16:
+      return impl(::sycl::ext::oneapi::bfloat16{});
+    case xla::PrimitiveType::F16:
+      return impl(::sycl::half{});
+    case xla::PrimitiveType::F32:
+      return impl(float{});
+    case xla::PrimitiveType::F64:
+      return impl(double{});
+    case xla::PrimitiveType::S8:
+      return impl(int8_t{});
+    case xla::PrimitiveType::S16:
+      return impl(int16_t{});
+    case xla::PrimitiveType::S32:
+      return impl(int32_t{});
+    case xla::PrimitiveType::S64:
+      return impl(int64_t{});
+    case xla::PrimitiveType::U8:
+      return impl(uint8_t{});
+    case xla::PrimitiveType::U16:
+      return impl(uint16_t{});
+    case xla::PrimitiveType::U32:
+      return impl(uint32_t{});
+    case xla::PrimitiveType::U64:
+      return impl(uint64_t{});
+    default:
+      return absl::InvalidArgumentError(
+          absl::StrCat("Unsupported element type for CUB scan: ",
+                       xla::PrimitiveType_Name(type)));
+  }
+}
+
+}  // namespace
+
+absl::Status CubScanLaunchKernel(xla::PrimitiveType type, void* d_temp_storage,
+                                 size_t temp_bytes, const void* d_in,
+                                 void* d_out, int64_t vector_length,
+                                 int64_t row_length, int64_t column_length,
+                                 CubScanKind kind, bool is_reverse,
+                                 ::sycl::queue* stream) {
+  return CubScanDispatch(type, &temp_bytes, d_in, d_out, vector_length,
+                         row_length, column_length, kind, is_reverse, stream);
+}
+
+absl::StatusOr<size_t> CubScanGetScratchSize(
+    xla::PrimitiveType type, int64_t vector_length, int64_t row_length,
+    int64_t column_length, CubScanKind kind, bool is_reverse) {
+  size_t temp_bytes = 0;
+  ABSL_RETURN_IF_ERROR(CubScanDispatch(type, &temp_bytes, nullptr, nullptr,
+                                       vector_length, row_length, column_length,
+                                       kind, is_reverse, nullptr));
+  return temp_bytes;
+}
+
+}  // namespace stream_executor::sycl
