+  static uint32_t XeGenerationFromXeValue(double value) {
+    const uint32_t scaled_value = static_cast<uint32_t>(value * 10.0);
+    // Xe1 maps to Xe 12, Xe1P maps to Xe 17. All other values map to 10 *
+    // value.
+    return scaled_value + (scaled_value < 20 ? 2 : 0);
+  }
